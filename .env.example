# Copy to .env and fill in. Never commit .env.

# --- Device ---
# auto | cuda | mps | cpu
KATACHI_DEVICE=auto

# --- Validation ---
KATACHI_MAX_UPLOAD_MB=10
KATACHI_MIN_RESOLUTION=512

# --- Background removal ---
# rembg | sam
KATACHI_SEGMENTER=rembg
KATACHI_REMBG_MODEL=u2net

# --- Species identification ---
# manual | plantnet  (more providers may be added)
KATACHI_SPECIES_PROVIDER=manual
PLANTNET_API_KEY=
# Predictions below this confidence show the "please choose a species" state.
KATACHI_SPECIES_MIN_CONFIDENCE=0.5

# --- Restyle generation ---
# diffusers | hosted
KATACHI_RESTYLE_BACKEND=diffusers
# Leave model IDs empty to use the defaults in src/katachi/config.py.
KATACHI_SD_MODEL=
KATACHI_CONTROLNET_CANNY_MODEL=
KATACHI_CONTROLNET_DEPTH_MODEL=
KATACHI_DEPTH_ESTIMATOR_MODEL=
# Generation resolution (long side, pixels). Lower is faster.
KATACHI_MAX_SIDE=768
KATACHI_NUM_INFERENCE_STEPS=30
# Optional hosted image-editing API fallback
KATACHI_HOSTED_API_URL=
KATACHI_HOSTED_API_KEY=

# --- Hugging Face ---
# Only needed for gated models or private Spaces.
HF_TOKEN=

# --- UI ---
KATACHI_WATERMARK_DEFAULT=true
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
